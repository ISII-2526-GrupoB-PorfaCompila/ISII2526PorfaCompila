@page "/reviews/createreview"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateReview> logger
@inject ReviewStateContainer reviewState

<h3>CreateReview</h3>

@* rental is the object that will be edited thanks to the form *@
<EditForm Model="review" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.UserName" class="form-control" id="UserName" />
                <label for="UserName">UserName </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.Country" class="form-control" id="Country" />
                <label for="Country">Country </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputSelect class="form-select" @bind-Value="@review.DriverType" id="DriverType">
                    <option value="@DriverTypes.Novato" default> Novato</option>
                    <option value="@DriverTypes.Experto" > Experto</option>
                </InputSelect>
                <label for="DriverType">DriverType</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Review your cars
                </button>
            </div>
        </div>
    </div>

    <h4>Review detail</h4>    
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfReviewItems">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>FuelType</th>
                    <th>Manufacturer</th>
                    <th>Color</th>
                    <th>Description</th>
                    <th>Rating</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in review.ReviewItems) {
                    <tr id="CarData_@item.CarId">
                        <td>@item.Model</td>
                        <td>@item.FuelType</td>
                        <td>@item.Manufacturer</td>
                        <td>@item.Color</td>
                        <td><InputText @bind-Value="item.Description" class="form-control" id="@($"description_{item.Description}")" /></td>
                        <td><InputNumber @bind-Value="item.Rating" class="form-control" id="@($"rating_{item.Rating}")" min="1" max="5" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <DialogReview Caption="Review cars"
    Message="Do you want to proceed to review the selected cars?"
    OnClose="@OnDialogClose"
    Type=DialogReview.Category.SaveNot>
    </DialogReview>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private void ModifyReviewItems()
    {
        navigation.NavigateTo("/reviews/selectcarsforreview");
    }
    private ReviewForCreateDTO review => reviewState.Review;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (review.ReviewItems.Count > 0)
            {
                try
                {
                    var reviewed = await apiclient.CreateReviewAsync(review);
                    reviewState.ReviewProcessed();
                    navigation.NavigateTo($"/reviews/detailreview/?ReviewID={reviewed.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }

    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    review.UserName = user.Identity.Name;
                }
            }
            review.UserName = review.UserName == null ? "" : review.UserName;
            review.Country = review.Country == null ? "" : review.Country;
            //review.DriverType = review.DriverType == null ? "" : review.DriverType;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
