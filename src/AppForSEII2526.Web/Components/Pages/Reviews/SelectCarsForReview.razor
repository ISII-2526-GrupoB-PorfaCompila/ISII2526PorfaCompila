@page "/reviews/selectcarsforreview"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCarsForReview> logger
@inject ReviewStateContainer reviewState
@inject NavigationManager navigation

<h3>Select Cars For Review</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Manufacturer</span>
                        <input type="text" id="manufacturer" @bind=manufacturer class="form-control" placeholder="manufacturer" aria-label="manufacturer" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">FuelType</span>
                        <input type="text" id="fuelType" @bind=fuelType class="form-control" placeholder="fuelType" aria-label="fuelType" aria-describedby="basic-addon1">
                    </div>
                </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchCars id="searchCars">Search cars</button>
                </div>

            </div>
            <div class="row">
                @if (cars == null) {
                    <p>Loading cars....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCars">
                            <thead>
                                <tr>
                                    <th>Model</th>
                                    <th>CarClass</th>
                                    <th>Manufacturer</th>
                                    <th>FuelType</th>
                                    <th>Color</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var car in cars) {
                                    <tr id="CarData_@car.Id">
                                        <td>@car.Model</td>
                                        <td>@car.CarClass</td>
                                        <td>@car.Manufacturer</td>
                                        <td>@car.FuelType</td>
                                        <td>@car.Color</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="carToReview_@car.Id" @onclick="@(() => AddCar(car))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hideReviewingCart">
            <div class="row">
                <h3>Review Cart</h3>
            </div>
            @foreach (ReviewItemDTO item in review.ReviewItems) {
                <div class="row">
                <button type="button" class="btn btn-light" id="removeCar_@item.CarId" @onclick="@(() => RemoveReviewItem(item))">@item.Manufacturer - @item.FuelType</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="reviewCarButton" @onclick=@ReviewCars>Review cars</button>
            </div>
        </div>
    </div>

@code {
    private bool hideReviewingCart { get { return review.ReviewItems.Count == 0; } }
    private ICollection<CarForReviewDTO> cars;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string manufacturer { get; set; }
    private string fuelType { get; set; }
    private ReviewForCreateDTO review => reviewState.Review;

    private bool hiddenReviewingCart = true;

    private void AddCar(CarForReviewDTO car) {
        reviewState.AddCarToReview(car);
    }

    private void RemoveReviewItem(ReviewItemDTO item) {
        reviewState.RemoveReviewItemToReview(item);
        if (review.ReviewItems.Count == 0) hiddenReviewingCart = true;
    }

    public async void SearchCars() {

        try {
            cars = await apiclient.GetCarsForReviewAsync(manufacturer, fuelType);
            errors = "";

        }
        catch (ApiException ex) {
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() {
        
        SearchCars();

       // return base.OnInitializedAsync();
    }

    private void ReviewCars() {
        navigation.NavigateTo("/reviews/createreview");
    }

}