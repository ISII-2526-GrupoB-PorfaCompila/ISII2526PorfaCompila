@page "/reviews/detailreview"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient

<h3>DetailReview</h3>

@if (review==null)
{
    <p>@error</p>
}else
{
        <table class="table table-borderless table-sm">
        <tr>
            <th>Name</th>
            <td id="UserName">@review.UserName</td>
        </tr>
        <tr>
            <th>Country</th>
            <td id="Country">@review.Country</td>
        </tr>
        <tr>
            <th>DriverType</th>
            <td id="DriverType">@review.DriverType</td>
        </tr>
        <tr>
            <th>Created</th>
            <td id="Created">@review.Created.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
    </table>

       <h4>Reviewed Cars</h4>

    <table class="table" id="ReviewedCars">
        <thead>
            <tr>
                <th scope="col">Model</th>
                <th scope="col">Manufacturer</th>
                <th scope="col">Color</th>
                <th scope="col">Description</th>
                <th scope="col">Rating</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ReviewItemDTO item in review.ReviewItems)
            {
                <tr id="ReviewItem_@item.Model">
                    <td>@item.Model</td>
                    <td>@item.Manufacturer</td>
                    <td>@item.Color</td>
                    <td>@item.Description</td>
                    <td>@item.Rating</td>
                </tr>
            }
        </tbody>
    </table>

}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int ReviewID { get; set; }
    private ReviewDetailDTO review;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }


    protected override async Task OnInitializedAsync() {

        //we check the user is logged in
        /*string userName = "";
        if (authenticationState is not null) {
            var authState = await authenticationState;
            var user = authState?.User;

            //we retrieve the id of the user logged in
            if (user is not null) {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("User")) {
                    userName = user.Identity.Name;
                }
            }
        }*/

        try {
            review = await apiclient.GetReviewAsync(ReviewID);
        }
        catch (ApiException exception) {
            review = null;
        }
        if ((review == null) /*|| (rental.UserNameCustomer != userName)*/) {
            error = $"Error! You are not authorized to see this rental or there is not a rental with id={ReviewID}";
        }


    }

}
