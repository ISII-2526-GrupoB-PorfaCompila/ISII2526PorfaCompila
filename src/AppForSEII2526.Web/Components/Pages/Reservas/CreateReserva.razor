@page "/mantenimientos/createreserva"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateReserva> logger
@inject ReservaStateContainer reservaState

<h3>CreateReserva</h3>

@* rental is the object that will be edited thanks to the form *@
<EditForm Model="reserva" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reserva.ApplicationUser" class="form-control" id="UserName" />
                <label for="UserName">Nombre de usuario </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reserva.ClientAddress" class="form-control" id="ClientAddress" />
                <label for="Direccion">Direccion </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reserva.PhoneNumber" class="form-control" id="NumeroTelefono" />
                <label for="Numero de telefono">Numero de telefono </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputSelect class="form-select" @bind-Value="@reserva.PaymentMethod" id="PaymentMethod">
                    <option value="@PaymentMethod.TarjetaDeCredito" default> Tarjeta de credito</option>
                    <option value="@PaymentMethod.PayPal"> Paypal</option>
                    <option value="@PaymentMethod.Metalico"> Metalico</option>
                </InputSelect>
                <label for="MetodoPago">Metodo de pago</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Reserva tus mantenimientos
                </button>
            </div>
        </div>
    </div>

    <h4>Detalle de la reserva</h4>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfReservaItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Numero de dias</th>
                    <th>Precio</th>
                    <th>Comentarios</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in reserva.ReservaItems)
                {
                    <tr id="CarData_@item.ReservaId">
                        <td>@item.Name</td>
                        <td>@item.NumberOfDays</td>
                        <td>@item.Price</td
                        <td><InputText @bind-Value="item.Comentarios" class="form-control" id="@($"comentarios_{item.Comentarios}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <DialogReview Caption="Contratar mantenimientos"
                  Message="¿Desea contratar estos mantenimientos?"
                  OnClose="@OnDialogClose"
                  Type=DialogReview.Category.SaveNot>
    </DialogReview>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private void ModifyReservaItems()
    {
        navigation.NavigateTo("/mantenimiento/selectmantenimiento");
    }
    private ReservaForCreateDTO reserva => reservaState.Reserva;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (reserva.ReservaItems.Count > 0)
            {
                try
                {
                    var reservado = await apiclient.CreateReservaAsync(reserva);
                    reservaState.ReservaProcessed();
                    navigation.NavigateTo($"/mantenimiento/reservadetail/?ReservaID={reservado.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
