@page "/rentals/detailrental"
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiservice

@* @attribute [Authorize] *@

@* 7. El sistema muestra un recibo con la información del alquiler indicando el nombre,
apellidos y dirección del usuario, coches alquilados (indicando su modelo, fabricante,
precio y cantidad), método de pago utilizado, fecha de inicio y fecha de finalización del
alquiler, fecha en la que se realizó el alquiler y precio total del alquiler. *@

<h3>RentalDetail</h3>

@if (rental==null)
{
    <p>@error</p>
}else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Name and Surname</th>
            <td id="NameSurname">@rental.Name @rental.Surname</td>
        </tr>
        <tr>
            <th>Delivery Address</th>
            <td id="DeliveryAddress">@rental.DeliveryCarDealer</td>
        </tr>
        <tr>
            <th>Payment Method</th>
            <td id="PaymentMethod">@rental.PaymentMethod</td>
        </tr>
        <tr>
            <th>Rental Date</th>
            <td id="RentalDate">@rental.RentingDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
        <tr>
            <th>Rental period</th>
            <td id="RentalPeriod">@rental.StartDate.DateTime.ToString("dd/MM/yyyy") - @rental.EndDate.DateTime.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>

    <!-- Lista de coches alquilados -->
    <h4>Rented Movies</h4>

    <table class="table" id="RentedMovies">
        <thead>
            <tr>
                <th scope="col">Model</th>
                <th scope="col">Manufacturer</th>
                <th scope="col">Price for Renting</th>
                <th scope="col">Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (RentalItemDTO item in rental.RentalItems)
            {
                <tr id="RentalItem_@item.Model">
                    <td>@item.Model</td>
                    <td>@item.Manufacturer</td>
                    <td>@item.RentingPrice €</td>
                    <td>@item.QuantityForRenting</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <th scope="row" colspan="2" class="text-end">Total Price</th>
            <td id="TotalPrice">@rental.TotalPrice €</td>
        </tfoot>

    </table>

    }

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int RentalID { get; set; }
    private RentalDetailDTO rental;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {

        //we check the user is logged in
        string userName = "";
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("User"))
                {
                    userName = user.Identity.Name;
                }
            }
        }

        try {
            rental = await apiservice.GetRentalDetailAsync(RentalID);
        }
        catch (ApiException exception)
        {
            rental = null;    
        }
        if ((rental == null) /* || (rental.Name != userName) */)
        {
            error = $"Error! You are not authorized to see this rental or there is not a rental with id={RentalID}";
        }


    }

}